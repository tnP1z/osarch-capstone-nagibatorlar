# Normalise line endings so the repo works the same on Windows and Linux.
* text=auto

# Bash scripts break with CRLF ("bad interpreter: /bin/bash^M"), so always LF.
*.sh   text eol=lf

# PowerShell scripts run on Windows, keep CRLF.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
